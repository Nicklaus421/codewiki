# =============================================================
# 云核软件资产治理平台 —— 环境变量示例
# 复制为 .env 后填写，用于 Docker Compose 与裸机部署
# =============================================================

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
LOG_LEVEL=info

# ---------- DeepSeek LLM（OpenAI 兼容协议）----------
# 必填：接入 DeepSeek 官方 API 时填写 API Key
# 留空则自动降级为静态分析生成文档（服务仍可用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=2
LLM_TEMPERATURE=0.3

# ---------- 代码仓约束 ----------
MAX_REPO_SIZE_MB=200
CLONE_TIMEOUT=300

# ---------- 跨域（如需前后端分离部署时调整） ----------
CORS_ORIGINS=*
